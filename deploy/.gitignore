data/
postgres_data/
redis_data/
dev-data/
dev-postgres_data/
dev-redis_data/

# Environment configuration (contains sensitive information)
.env
.env.host-dev
.env.host-dev.local

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log
