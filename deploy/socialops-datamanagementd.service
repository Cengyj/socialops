[Unit]
Description=SocialOps Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=socialops
Group=socialops
WorkingDirectory=/opt/socialops
ExecStart=/opt/socialops/datamanagementd \
  -socket-path /tmp/socialops-datamanagement.sock \
  -sqlite-path /var/lib/socialops/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
