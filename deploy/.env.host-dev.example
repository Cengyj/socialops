# Local host-development environment for SocialOps.
# Copy to deploy/.env.host-dev and adjust if needed.

POSTGRES_USER=socialops
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=socialops
POSTGRES_HOST_PORT=5433

REDIS_PASSWORD=
REDIS_DB=0
REDIS_HOST_PORT=6380

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_ENABLE_TLS=false

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug
RUN_MODE=standard
TZ=Asia/Shanghai

ADMIN_EMAIL=admin@socialops.local
ADMIN_PASSWORD=change-me-local-dev

JWT_SECRET=replace-with-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
